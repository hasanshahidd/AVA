[Unit]
Description=Fire the AVA register CVE enrichment sweep every ~10 min

[Timer]
# Soon after boot, then every ~10 min. Persistent=true runs a missed fire once
# the box comes back. The sweep's own flock makes an overlap harmless: a fire
# while the previous drain is still running exits immediately.
OnBootSec=3min
OnUnitActiveSec=10min
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
